---
/**
 * HTML shell shared by every page: fonts, global styles, metadata, masthead, footer.
 * Pages pass a title/description and render their content into the default slot.
 */
// Self-hosted fonts (bundled at build time, no third-party requests).
// Latin + Latin Extended subsets are enough for English/Italian names and titles.
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-serif/latin-400.css';
import '@fontsource/ibm-plex-serif/latin-ext-400.css';
import '@fontsource/ibm-plex-serif/latin-400-italic.css';
import '@fontsource/ibm-plex-serif/latin-ext-400-italic.css';
import '@fontsource/ibm-plex-serif/latin-500.css';
import '@fontsource/ibm-plex-serif/latin-ext-500.css';
import '@fontsource/ibm-plex-serif/latin-600.css';
import '@fontsource/ibm-plex-serif/latin-ext-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '../styles/base.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { site } from '../data/site.ts';
import { FIXTURES_ENABLED, FIXTURE_MARKER } from '../lib/fixtures.ts';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
}

const { title, description, type, image, noindex } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} type={type} image={image} noindex={noindex} />
    {site.brand.favicon && <link rel="icon" href={site.brand.favicon} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {FIXTURES_ENABLED && (
      <p class="fixture-banner" role="status">
        {FIXTURE_MARKER}: this build uses sample content from src/content-fixtures/ — not production data.
      </p>
    )}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .fixture-banner {
    background: #ffe9a8;
    color: #3d2b00;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-xs) var(--gutter);
  }

  main:focus {
    outline: none;
  }
</style>
