---
/**
 * HTML shell shared by every page: fonts, global styles, metadata, masthead, footer.
 * Pages pass a title/description and render their content into the default slot.
 */
// Self-hosted fonts (bundled at build time, no third-party requests).
// Inter Sans is vendored locally; IBM Plex Serif/Mono use Latin + Latin Extended subsets.
import '@fontsource/ibm-plex-serif/latin-400.css';
import '@fontsource/ibm-plex-serif/latin-ext-400.css';
import '@fontsource/ibm-plex-serif/latin-400-italic.css';
import '@fontsource/ibm-plex-serif/latin-ext-400-italic.css';
import '@fontsource/ibm-plex-serif/latin-500.css';
import '@fontsource/ibm-plex-serif/latin-ext-500.css';
import '@fontsource/ibm-plex-serif/latin-600.css';
import '@fontsource/ibm-plex-serif/latin-ext-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '../styles/base.css';
import '../styles/fonts.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { site } from '../data/site.ts';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
}

const { title, description, type, image, noindex } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} type={type} image={image} noindex={noindex} />
    {site.brand.favicon && <link rel="icon" href={site.brand.favicon} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/*
      Theme, resolved before first paint so pages never flash the wrong palette.
      With no explicit choice nothing is set and the CSS follows prefers-color-scheme
      (so the site still themes itself correctly without JavaScript). An explicit
      choice becomes <html data-theme>, and only then does the toggle appear.
    */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.js = '';
        const KEY = 'cisd-theme';
        const system = () => (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const read = () => {
          try {
            const stored = localStorage.getItem(KEY);
            return stored === 'light' || stored === 'dark' ? stored : null;
          } catch {
            return null;
          }
        };
        const stored = read();
        if (stored) root.dataset.theme = stored;

        /*
         * Durations live in tokens.css; read them rather than restating them here.
         *
         * Mind the unit. `--duration-flash` is authored as `1600ms`, but the CSS minifier
         * ships it as `1.6s`, so a bare parseFloat returns 1.6 — and a 1.6ms timer hides the
         * frame on the next tick, which is exactly the bug this comment exists to prevent.
         * A CSS <time> is either `s` or `ms`; both have to be honoured.
         */
        const ms = (name, fallback) => {
          const raw = getComputedStyle(root).getPropertyValue(name).trim();
          const value = parseFloat(raw);
          if (!Number.isFinite(value)) return fallback;
          return raw.endsWith('ms') ? value : value * 1000;
        };

        /*
         * Arm the eased repaint for the length of one swap. It is not left on: a permanent
         * transition makes ordinary navigation smear, and would fade the palette in on first
         * paint, which is the one thing the script above exists to prevent.
         */
        let fading;
        const armFade = () => {
          root.classList.add('theme-transition');
          clearTimeout(fading);
          fading = setTimeout(() => root.classList.remove('theme-transition'), ms('--duration-theme', 500));
        };

        /*
         * The easter egg: the bang lands just after the frame, at a volume you have to be
         * listening for. 1.3 seconds, which keeps it under the 3-second line where WCAG 1.4.2
         * would require a stop control for audio that starts on its own.
         *
         * Built on first use, never at load, so a visitor who never switches theme never
         * fetches it. `play()` can be refused — some browsers want a fresher user gesture
         * than a click 180ms ago — and a refusal is fine: this is decoration, so it fails
         * silently rather than logging at people.
         */
        const BANG_VOLUME = 0.08;
        const BANG_DELAY = 180;
        let bang;
        const playBang = () => {
          try {
            bang ??= new Audio('/audio/flash-out.mp3');
            bang.volume = BANG_VOLUME;
            bang.currentTime = 0;
            const played = bang.play();
            if (played) played.catch(() => {});
          } catch {}
        };

        /* Dark → light only — the direction that hurts. */
        let flashing;
        const flashOut = () => {
          const frame = document.querySelector('[data-theme-flash]');
          if (!frame) return;
          // Hide, force a layout read, show: without the read in between the browser never
          // sees `display: none`, and the animation does not restart on a second switch.
          frame.hidden = true;
          void frame.offsetHeight;
          frame.hidden = false;
          setTimeout(playBang, BANG_DELAY);
          clearTimeout(flashing);
          flashing = setTimeout(() => {
            frame.hidden = true;
          }, ms('--duration-flash', 1600));
        };

        /** Label the toggle with the action it performs, not the state it is in. */
        const label = (button) => {
          const next = (root.dataset.theme ?? system()) === 'dark' ? 'light' : 'dark';
          button.setAttribute('aria-label', `Switch to the ${next} theme`);
          button.setAttribute('title', `Switch to the ${next} theme`);
        };

        document.addEventListener('click', (event) => {
          const button = event.target.closest('[data-theme-toggle]');
          if (!button) return;
          const next = (root.dataset.theme ?? system()) === 'dark' ? 'light' : 'dark';
          armFade();
          if (next === 'light') flashOut();
          try {
            // Choosing your own system preference clears the override again.
            if (next === system()) {
              localStorage.removeItem(KEY);
              delete root.dataset.theme;
            } else {
              localStorage.setItem(KEY, next);
              root.dataset.theme = next;
            }
          } catch {
            root.dataset.theme = next;
          }
          label(button);
        });

        document.addEventListener('DOMContentLoaded', () => {
          const button = document.querySelector('[data-theme-toggle]');
          if (button) label(button);
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
