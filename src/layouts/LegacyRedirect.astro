---
/**
 * Compatibility stub for a legacy URL (cisd.di.univr.it/profile/12/ …).
 * GitHub Pages cannot send HTTP redirects, so the page points browsers (meta refresh),
 * crawlers (canonical, noindex) and humans (visible link) to the new address.
 */
import type { LegacyTarget } from '../lib/legacy.ts';

interface Props {
  target: LegacyTarget;
  legacyPath: string;
}

const { target, legacyPath } = Astro.props;
const newUrl = new URL(target.to, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${newUrl}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={newUrl} />
    <title>{target.title} — moved</title>
    <!--
      This page exists for half a second and deliberately loads neither the site
      stylesheet nor the fonts, so it is the one place that repeats colour values
      instead of reading them from src/styles/tokens.css. The four values below are
      --light-ink / --light-paper / --light-accent-strong and their dark equivalents;
      keep them in step when the palette changes (docs/site-settings.md).

      IMPORTANT: every selector is anchored to .legacy-redirect-page. This component
      is imported by the normal /news/[slug]/ route as well as numeric legacy routes;
      unqualified html/body selectors would therefore leak into ordinary news pages.
    -->
    <style>
      body.legacy-redirect-page { color-scheme: light dark; font-family: system-ui, sans-serif; max-width: 40rem; margin: 15vh auto; padding: 0 1.5rem; line-height: 1.5; color: #141a2e; background: #f6f7fb; }
      .legacy-redirect-page a { color: #372c9e; }
      .legacy-redirect-page code { font-family: ui-monospace, monospace; font-size: 0.9em; }
      @media (prefers-color-scheme: dark) {
        body.legacy-redirect-page { color: #e6e9f5; background: #0a0f1e; }
        .legacy-redirect-page a { color: #c6c4ff; }
      }
    </style>
  </head>
  <body class="legacy-redirect-page">
    <h1>This page has moved</h1>
    <p>
      The address <code>{legacyPath}</code> belonged to the former CISD website.
      Its content is now at <a href={target.to}>{target.title}</a>.
    </p>
    <p>You will be taken there automatically; if not, use the link above.</p>
  </body>
</html>
