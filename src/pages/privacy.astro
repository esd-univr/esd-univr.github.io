---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site.ts';
---

<PageLayout
  title="Privacy"
  eyebrow="Site information"
  description={`Privacy information for the ${site.shortName} website.`}
  width="narrow"
>
  <div class="section prose">
    <p>
      This is a static research website. CISD does not use analytics, advertising, tracking
      pixels or profiling services, and the site does not provide user accounts or submission
      forms.
    </p>

    <h2>Theme preference</h2>
    <p>
      If you use the light/dark theme switch, the site may store the key <code>cisd-theme</code>
      in your browser's local storage with the value <code>light</code> or <code>dark</code>. It is
      used only to remember that display preference. The CISD site code does not transmit that
      value to CISD or use it for analytics or profiling. If no explicit preference is stored,
      the site follows your operating-system colour preference.
    </p>

    <h2>Hosting and external links</h2>
    <p>
      The site is hosted on GitHub Pages. As the hosting provider, GitHub may process ordinary
      technical request and connection data according to its own privacy terms. Links to the
      University of Verona, publication services, project websites, social profiles and other
      external sites lead to services with their own privacy policies.
    </p>
    <p>
      <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub Privacy Statement</a>
    </p>

    <h2>University of Verona</h2>
    <p>
      For institutional information about personal-data processing and data-protection rights,
      consult the University of Verona privacy information.
    </p>
    <p><a href="https://www.univr.it/en/web/guest/privacy-policy">University of Verona privacy policy</a></p>

    <p class="meta">Last reviewed: 26 August 2026.</p>
  </div>
</PageLayout>
