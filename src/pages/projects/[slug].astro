---
import { getEntries, render } from 'astro:content';
import LinkList from '../../components/LinkList.astro';
import NewsList from '../../components/NewsList.astro';
import PeopleList from '../../components/PeopleList.astro';
import PublicationList from '../../components/PublicationList.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getGroups, getNewsFor, getPeople, getProjects, getPublicationsForProject, type Project } from '../../lib/content.ts';
import { formatYearRange } from '../../lib/format.ts';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const hasBody = (project.body ?? '').trim().length > 0;
const groups = (await getGroups()).filter((group) => d.groups.some((id) => id === group.id));
const team = await getEntries(d.people);
const publications = await getPublicationsForProject(project);
const news = await getNewsFor('projects', project.id);
const people = await getPeople();

const STATUS_LABEL = { active: 'Active', completed: 'Completed' } as const;
const fundingLine = d.funding
  ? [d.funding.programme, d.funding.funder, d.funding.grant && `grant ${d.funding.grant}`].filter(Boolean).join(' · ')
  : '';
const links = [
  d.url && { label: 'Project website', href: d.url },
  ...groups.map((group) => ({ label: 'Group', href: `/research/#${group.id}`, text: group.data.name })),
].filter((x): x is { label: string; href: string; text?: string } => Boolean(x));
---

<PageLayout title={d.name} eyebrow={d.acronym ? `Project · ${d.acronym}` : 'Project'} lede={d.summary}>
  <p slot="header" class="facts">
    <span><span class="eyebrow">Period</span> {formatYearRange(d.start, d.end)}</span>
    <span><span class="eyebrow">Status</span> {STATUS_LABEL[d.status]}</span>
    {fundingLine && <span><span class="eyebrow">Funding</span> {fundingLine}</span>}
  </p>

  <div class="layout">
    <div class="main">
      {hasBody && (
        <section class="section prose">
          <Content />
        </section>
      )}
      {publications.length > 0 && (
        <section class="section" aria-labelledby="project-publications">
          <h2 id="project-publications">Publications</h2>
          <PublicationList publications={publications} people={people} headingLevel={3} />
        </section>
      )}
      {news.length > 0 && (
        <section class="section" aria-labelledby="project-news">
          <h2 id="project-news">News</h2>
          <NewsList items={news} />
        </section>
      )}
    </div>
    <aside class="aside">
      {team.length > 0 && (
        <section>
          <h2 class="eyebrow">People</h2>
          <PeopleList people={team} size={48} />
        </section>
      )}
      {links.length > 0 && (
        <section>
          <LinkList items={links} />
        </section>
      )}
    </aside>
  </div>
</PageLayout>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-xl);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .facts > span {
    display: grid;
    gap: var(--space-2xs);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
    gap: var(--space-2xl);
    padding-block: var(--space-xl);
  }

  .main .section {
    padding-block: var(--space-xl);
  }

  .main .section:first-child {
    padding-top: 0;
  }

  .main h2 {
    margin-bottom: var(--space-lg);
  }

  .aside {
    display: grid;
    gap: var(--space-xl);
    align-content: start;
    padding-top: var(--space-sm);
  }

  .aside .eyebrow {
    margin-bottom: var(--space-sm);
  }

  @media (max-width: 56rem) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
