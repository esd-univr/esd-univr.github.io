---
import EmptyState from '../../components/EmptyState.astro';
import ProjectList from '../../components/ProjectList.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getProjects } from '../../lib/content.ts';
import { site } from '../../data/site.ts';

const projects = await getProjects();
const active = projects.filter((p) => p.data.status === 'active');
const completed = projects.filter((p) => p.data.status === 'completed');
---

<PageLayout title="Projects" eyebrow={site.shortName} description="Research projects of the CISD groups." bleed>
  {projects.length === 0 && (
    <div class="band"><div class="section container"><EmptyState message="Projects will be listed here." /></div></div>
  )}

  {active.length > 0 && (
    <div class="band">
      <section class="section container" aria-labelledby="projects-active">
        <h2 id="projects-active" class="group-heading">Active</h2>
        <ProjectList projects={active} />
      </section>
    </div>
  )}

  {completed.length > 0 && (
    <div class="band band--sunken">
      <section class="section container" aria-labelledby="projects-completed">
        <h2 id="projects-completed" class="group-heading">Completed</h2>
        <ProjectList projects={completed} />
      </section>
    </div>
  )}
</PageLayout>

<style>
  /* Lists need less vertical ceremony than narrative sections. */
  .section {
    padding-block: var(--space-xl);
  }

  .group-heading {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: var(--space-md);
  }
</style>
