---
import EmptyState from '../../components/EmptyState.astro';
import ProjectList from '../../components/ProjectList.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getProjects } from '../../lib/content.ts';

const projects = await getProjects();
const active = projects.filter((p) => p.data.status === 'active');
const completed = projects.filter((p) => p.data.status !== 'active');
---

<PageLayout title="Projects" eyebrow="Electronic Systems Design" description="Research projects of the ESD group.">
  {projects.length === 0 && <EmptyState message="Projects will be listed here." />}

  {active.length > 0 && (
    <section class="section" aria-labelledby="projects-active">
      <h2 id="projects-active" class="group-heading">Active</h2>
      <ProjectList projects={active} />
    </section>
  )}

  {completed.length > 0 && (
    <section class="section" aria-labelledby="projects-completed">
      <h2 id="projects-completed" class="group-heading">Completed</h2>
      <ProjectList projects={completed} />
    </section>
  )}
</PageLayout>

<style>
  .group-heading {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: var(--space-lg);
  }
</style>
