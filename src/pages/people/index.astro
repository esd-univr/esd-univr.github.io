---
import EmptyState from '../../components/EmptyState.astro';
import PeopleList from '../../components/PeopleList.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getGroups, getPeople } from '../../lib/content.ts';
import { groupPeople } from '../../lib/people.ts';
import { site } from '../../data/site.ts';

const people = await getPeople();
const groups = await getGroups();
const sections = groupPeople(
  people,
  groups.map((group) => ({ id: group.id, label: group.data.name })),
);
---

<PageLayout title="People" eyebrow={site.shortName} description="Members of the CISD research groups." width="wide">
  {people.length === 0 && <EmptyState message="Group members will be listed here." />}

  {sections.map((section) => (
    <section class="section" data-group={section.id} aria-labelledby={`people-${section.id}`}>
      <h2 id={`people-${section.id}`} class="group-heading">{section.label}</h2>
      <PeopleList people={section.people} />
    </section>
  ))}
</PageLayout>

<style>
  .section {
    padding-block: var(--space-xl);
  }

  .group-heading {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    /* This heading IS the group's name, so the hue restates what the words already say. */
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }
</style>
