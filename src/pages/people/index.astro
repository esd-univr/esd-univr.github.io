---
import EmptyState from '../../components/EmptyState.astro';
import PeopleList from '../../components/PeopleList.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getGroups, getPeople } from '../../lib/content.ts';
import { comparePeople, groupPeople } from '../../lib/people.ts';
import { site } from '../../data/site.ts';

const people = await getPeople();
const groups = await getGroups();
const members = people.filter((person) => person.data.relationship !== 'collaborator');
const collaborators = people.filter((person) => person.data.relationship === 'collaborator').sort(comparePeople);
const sections = groupPeople(
  members,
  groups.map((group) => ({ id: group.id, label: group.data.name })),
);
const ungroupedMembers = members.filter((person) => person.data.groups.length === 0).sort(comparePeople);
const sectionsBeforeCollaborators = sections.length + (ungroupedMembers.length > 0 ? 1 : 0);
---

<PageLayout title="People" eyebrow={site.shortName} description="Members and collaborators of CISD." bleed>
  {people.length === 0 && (
    <div class="band"><div class="section container"><EmptyState message="CISD members will be listed here." /></div></div>
  )}

  {/* A stated laboratory association gets its group hue. Current CISD members whose
      laboratory has not been explicitly stated remain members without being forced into a
      group by research similarity. Collaborators stay separate from both. */}
  {sections.map((section, index) => (
    <div class:list={['band', index % 2 === 1 && 'band--sunken']} data-group={section.id}>
      <section class="section container" aria-labelledby={`people-${section.id}`}>
        <h2 id={`people-${section.id}`} class="group-heading">{section.label}</h2>
        <PeopleList people={section.people} />
      </section>
    </div>
  ))}

  {ungroupedMembers.length > 0 && (
    <div class:list={['band', sections.length % 2 === 1 && 'band--sunken']}>
      <section id="cisd-members" class="section container" aria-labelledby="people-cisd-members">
        <h2 id="people-cisd-members" class="group-heading group-heading--neutral">CISD</h2>
        <PeopleList people={ungroupedMembers} />
      </section>
    </div>
  )}

  {collaborators.length > 0 && (
    <div class:list={['band', sectionsBeforeCollaborators % 2 === 1 && 'band--sunken']}>
      <section id="collaborators" class="section container" aria-labelledby="people-collaborators">
        <h2 id="people-collaborators" class="group-heading group-heading--neutral">Collaborators</h2>
        <PeopleList people={collaborators} />
      </section>
    </div>
  )}
</PageLayout>

<style>
  .section {
    padding-block: var(--space-xl);
  }

  .group-heading {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    /* Group headings restate the group already named in text, so hue is not sole meaning. */
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .group-heading--neutral {
    color: var(--color-ink-3);
  }
</style>
