---
import EmptyState from '../../components/EmptyState.astro';
import PeopleList from '../../components/PeopleList.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPeople } from '../../lib/content.ts';
import { groupPeople } from '../../lib/people.ts';

const people = await getPeople();
const { members, external, former } = groupPeople(people);
---

<PageLayout title="People" eyebrow="Electronic Systems Design" description="Members of the ESD research group.">
  {people.length === 0 && <EmptyState message="Group members will be listed here." />}

  {members.map((section) => (
    <section class="section" aria-labelledby={`people-${section.id}`}>
      <h2 id={`people-${section.id}`} class="group-heading">{section.label}</h2>
      <PeopleList people={section.people} />
    </section>
  ))}

  {external.length > 0 && (
    <section class="section" aria-labelledby="people-external">
      <h2 id="people-external" class="group-heading">External collaborators</h2>
      <PeopleList people={external} />
    </section>
  )}

  {former.length > 0 && (
    <section class="section" aria-labelledby="people-former">
      <h2 id="people-former" class="group-heading">Alumni and former members</h2>
      <PeopleList people={former} size={56} />
    </section>
  )}
</PageLayout>

<style>
  .group-heading {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: var(--space-lg);
  }
</style>
