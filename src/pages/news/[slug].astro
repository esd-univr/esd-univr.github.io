---
import { Image } from 'astro:assets';
import { getEntries, getEntry, render } from 'astro:content';
import LinkList from '../../components/LinkList.astro';
import Portrait from '../../components/Portrait.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import LegacyRedirect from '../../layouts/LegacyRedirect.astro';
import { getNews, type NewsItem } from '../../lib/content.ts';
import { formatDate } from '../../lib/format.ts';
import { isLegacyId, legacyTargets, type LegacyTarget } from '../../lib/legacy.ts';

export async function getStaticPaths() {
  const news = await getNews();
  const paths: Array<{ params: { slug: string }; props: Props }> = [];
  for (const entry of news) {
    if (isLegacyId(entry.id)) {
      throw new Error(`News slug "${entry.id}" is purely numeric; numeric slugs are reserved for legacy ids`);
    }
    paths.push({ params: { slug: entry.id }, props: { entry } });
  }
  for (const target of legacyTargets(news, (e) => `/news/${e.id}/`, (e) => e.data.title)) {
    paths.push({ params: { slug: target.legacyId }, props: { legacy: target } });
  }
  return paths;
}

type Props = { entry: NewsItem; legacy?: undefined } | { entry?: undefined; legacy: LegacyTarget };

const { entry, legacy } = Astro.props;
const d = entry?.data;
const author = d?.author ? await getEntry(d.author) : undefined;
const related = entry
  ? [
      ...(await getEntries(d!.people)).map((p) => ({ label: 'People', href: `/people/${p.id}/`, text: p.data.name })),
      ...(await getEntries(d!.projects)).map((p) => ({ label: 'Project', href: `/projects/${p.id}/`, text: p.data.acronym ?? p.data.name })),
    ]
  : [];
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const eyebrow = d ? `${formatDate(d.date)}${d.category ? ` · ${d.category}` : ''}` : '';
---

{legacy ? (
  <LegacyRedirect target={legacy} legacyPath={`/news/${legacy.legacyId}/`} />
) : (
  <PageLayout title={d!.title} eyebrow={eyebrow} lede={d!.summary} type="article">
    {author && (
      <p slot="header" class="byline" lang="en">
        <Portrait name={author.data.name} photo={author.data.photo} size={32} variant="avatar" />
        <span>By <a href={`/people/${author.id}/`}>{author.data.name}</a></span>
      </p>
    )}

    <div class="layout" lang={d!.lang}>
      <div class="main">
        {d!.image && (
          <Image class="article__figure" src={d!.image} alt={d!.imageAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 60rem) 68rem, 100vw" />
        )}
        {Content && (
          <section class="section prose article__body">
            <Content />
          </section>
        )}
      </div>

      <aside class="aside" lang="en">
        {related.length > 0 && (
          <section>
            <h2 class="eyebrow">Related</h2>
            <LinkList items={related} />
          </section>
        )}
        <p class="article__back"><a href="/news/">← All news</a></p>
      </aside>
    </div>
  </PageLayout>
)}

<style>
  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
    gap: var(--space-2xl);
    padding-block: var(--space-xl);
  }

  .main .section {
    padding-block: var(--space-xl);
  }

  .main .section:first-child {
    padding-top: 0;
  }

  .article__figure {
    width: min(100%, 72rem);
    height: auto;
    border-radius: var(--radius);
    margin-bottom: var(--space-xl);
  }

  .article__body {
    max-width: 72ch;
  }

  .aside {
    display: grid;
    gap: var(--space-xl);
    align-content: start;
    padding-top: var(--space-sm);
  }

  .aside .eyebrow {
    margin-bottom: var(--space-sm);
  }

  .article__back {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  @media (max-width: 56rem) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
