---
/**
 * Research page: one section per CISD group, with that group's topics.
 *
 * Each group section and each topic carries its own id, so `/research/#esd` and
 * `/research/#digital-twins-and-smart-manufacturing` are both stable addresses. The
 * `areas:` field of an opportunity links to the topic anchor.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import { getGroups, getResearchForGroup } from '../../lib/content.ts';
import { site } from '../../data/site.ts';

const groups = await getGroups();
const sections = await Promise.all(
  groups.map(async (group) => ({ group, topics: await getResearchForGroup(group.id) })),
);
---

<PageLayout
  title="Research"
  eyebrow={site.shortName}
  lede={`The ${site.shortName} groups and the topics they work on.`}
  description="Research groups and topics of CISD, University of Verona."
  bleed
>
  {/*
    One full-bleed band per group, tinted at 7% of that group's own hue: the page reads as
    three plates instead of one white sheet, and the tint says whose. This is the system's
    one exception to "a tinted surface appears once per page" — here the three plates are
    the page's subject, not decoration.
  */}
  {sections.map(({ group, topics }) => (
    <div class="band band--tint" data-group={group.id}>
    <section class="section group container" id={group.id} aria-labelledby={`group-${group.id}`}>
      <div class="group__intro">
        <p class="eyebrow">{group.data.shortName}</p>
        <h2 id={`group-${group.id}`}>{group.data.name}</h2>
        <p class="group__summary">{group.data.summary}</p>
      </div>
      {topics.length > 0 && (
        <ol class="topics">
          {topics.map((topic, index) => (
            <li class="topic" id={topic.id}>
              <span class="topic__index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="topic__name">{topic.data.name}</h3>
                <p class="topic__summary">{topic.data.summary}</p>
                {topic.data.details.length > 0 && (
                  <ul class="topic__details">
                    {topic.data.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      )}
    </section>
    </div>
  ))}
</PageLayout>

<style>
  /* Each group sits on its own tinted band, so the boundary is the change of ground and
     the section needs no rule of its own. */
  .group {
    padding-block: var(--space-2xl);
  }

  .group__intro {
    max-width: var(--measure);
    margin-bottom: var(--space-xl);
  }

  /* The group's short name in the group's own hue; the acronym itself carries the meaning. */
  .group__intro .eyebrow {
    color: var(--color-accent);
  }

  .group__intro h2 {
    font-size: var(--text-3xl);
    margin-block: var(--space-2xs) var(--space-sm);
  }

  .group__summary {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
  }

  /*
   * auto-fill, not auto-fit: PARCO and IoT4Care have a single topic each, and auto-fit
   * collapses the empty tracks so that one block stretches the whole band — its summary
   * then ran to about 110 characters, well past --measure, and its 2px accent rule spanned
   * the full width. auto-fill keeps every topic block the same width whatever the count,
   * so the rules line up across all three plates.
   */
  .topics {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: var(--space-xl);
  }

  .topic {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    /* Inside a [data-group] section --color-accent is that group's hue, so every topic
       opens in it without the topic knowing which group it belongs to. */
    border-top: 2px solid var(--color-accent);
  }

  .topic__index {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  .topic__name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .topic__summary {
    max-width: var(--measure);
    color: var(--color-ink-2);
  }

  .topic__details {
    margin-top: var(--space-sm);
    padding-left: 1.1em;
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-ink-3);
  }
</style>
