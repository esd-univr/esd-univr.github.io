---
import { Image } from 'astro:assets';
import EmptyState from '../../components/EmptyState.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getResearchAreas } from '../../lib/content.ts';

const areas = await getResearchAreas();
const active = areas.filter((a) => a.data.status === 'active');
const archived = areas.filter((a) => a.data.status === 'archived');
---

<PageLayout title="Research" eyebrow="Electronic Systems Design" description="Research themes of the ESD group.">
  {areas.length === 0 && <EmptyState message="Research themes will be listed here." />}

  {active.length > 0 && (
    <section class="section">
      <ol class="areas">
        {active.map((area, index) => (
          <li class="area">
            <span class="area__index">{String(index + 1).padStart(2, '0')}</span>
            <div class="area__body">
              <h2 class="area__name"><a href={`/research/${area.id}/`}>{area.data.name}</a></h2>
              <p class="area__summary">{area.data.summary}</p>
            </div>
            {area.data.logo && (
              <Image class="area__logo" src={area.data.logo} alt={area.data.logoAlt ?? `${area.data.name} logo`} width={200} height={100} fit="contain" />
            )}
          </li>
        ))}
      </ol>
    </section>
  )}

  {archived.length > 0 && (
    <section class="section">
      <h2 class="eyebrow">Archived themes</h2>
      <ul class="archived">
        {archived.map((area) => (
          <li><a href={`/research/${area.id}/`}>{area.data.name}</a> — {area.data.summary}</li>
        ))}
      </ul>
    </section>
  )}
</PageLayout>

<style>
  .areas {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .area {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: var(--space-md) var(--space-lg);
    align-items: start;
    padding-block: var(--space-xl);
    border-top: var(--rule);
  }

  .area:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .area__index {
    font-family: var(--font-mono);
    color: var(--color-accent);
    padding-top: 0.4em;
  }

  .area__name {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-sm);
  }

  .area__name a {
    text-decoration: none;
  }

  .area__name a:hover {
    text-decoration: underline;
  }

  .area__summary {
    max-width: var(--measure);
    color: var(--color-ink-2);
    font-size: var(--text-lg);
  }

  .area__logo {
    width: 12.5rem;
    height: 6.25rem;
    object-fit: contain;
  }

  .archived {
    padding-left: 1.2em;
    margin-top: var(--space-md);
    display: grid;
    gap: var(--space-xs);
    color: var(--color-ink-2);
  }

  @media (max-width: 48rem) {
    .area {
      grid-template-columns: 3rem 1fr;
    }

    .area__logo {
      grid-column: 2;
    }
  }
</style>
