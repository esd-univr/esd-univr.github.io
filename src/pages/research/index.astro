---
/** Research page: one section per CISD group, with that group's topics. */
import PageLayout from '../../layouts/PageLayout.astro';
import { getGroups, getResearchForGroup } from '../../lib/content.ts';
import { site } from '../../data/site.ts';

const groups = await getGroups();
const sections = await Promise.all(
  groups.map(async (group) => ({ group, topics: await getResearchForGroup(group.id) })),
);
---

<PageLayout
  title="Research"
  eyebrow={site.shortName}
  lede={`The ${site.shortName} groups and the topics they work on.`}
  description="Research groups and topics of CISD, University of Verona."
>
  {sections.map(({ group, topics }) => (
    <section class="section group" id={group.id} aria-labelledby={`group-${group.id}`}>
      <div class="group__intro">
        <p class="eyebrow">{group.data.shortName}</p>
        <h2 id={`group-${group.id}`}>{group.data.name}</h2>
        <p class="group__summary">{group.data.summary}</p>
      </div>
      {topics.length > 0 && (
        <ol class="topics">
          {topics.map((topic, index) => (
            <li class="topic">
              <span class="topic__index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="topic__name">{topic.data.name}</h3>
                <p class="topic__summary">{topic.data.summary}</p>
                {topic.data.details.length > 0 && (
                  <ul class="topic__details">
                    {topic.data.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      )}
    </section>
  ))}
</PageLayout>

<style>
  .group {
    padding-block: var(--space-2xl);
    border-top: var(--rule);
  }

  .group:first-of-type {
    border-top: 0;
  }

  .group__intro {
    max-width: var(--measure);
    margin-bottom: var(--space-xl);
  }

  .group__intro h2 {
    font-size: var(--text-3xl);
    margin-block: var(--space-2xs) var(--space-sm);
  }

  .group__summary {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
  }

  .topics {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-xl);
  }

  .topic {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule-strong);
  }

  .topic__index {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  .topic__name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .topic__summary {
    color: var(--color-ink-2);
  }

  .topic__details {
    margin-top: var(--space-sm);
    padding-left: 1.1em;
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-ink-3);
  }
</style>
