---
import LinkList from '../components/LinkList.astro';
import { site } from '../data/site.ts';
import PageLayout from '../layouts/PageLayout.astro';

const org = site.organisation;
const links = [
  { label: 'Department', href: org.departmentUrl, text: org.department },
  { label: 'University', href: org.universityUrl, text: org.university },
  { label: 'Map', href: org.mapUrl, text: 'OpenStreetMap' },
  { label: 'GitHub', href: site.links.github },
];
---

<PageLayout title="Contacts" eyebrow="Institutional information" description={`How to reach the ${site.name} group at the ${org.university}.`}>
  <div class="layout">
    <section class="section">
      <h2 class="eyebrow">Address</h2>
      <address class="address">
        <span>{site.name} ({site.shortName})</span>
        <span>{org.department}</span>
        <span>{org.university}</span>
        {org.address.map((line) => <span>{line}</span>)}
      </address>
      <p class="note">Individual contact details are listed on each member's page under <a href="/people/">People</a>.</p>
    </section>
    <section class="section">
      <h2 class="eyebrow">Links</h2>
      <LinkList items={links} />
    </section>
  </div>
</PageLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-2xl);
  }

  .layout .eyebrow {
    margin-bottom: var(--space-sm);
  }

  .address {
    font-style: normal;
    font-size: var(--text-lg);
    display: grid;
    gap: var(--space-2xs);
  }

  .note {
    margin-top: var(--space-lg);
    color: var(--color-ink-2);
    max-width: var(--measure);
  }
</style>
