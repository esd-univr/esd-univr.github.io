---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page does not exist." noindex>
  <div class="container notfound">
    <p class="eyebrow">Error 404</p>
    <h1>Page not found</h1>
    <p class="lede">
      The address you followed does not exist on this site. This static website replaced the former
      CISD web application; its login, settings and administration pages no longer exist.
    </p>
    <nav class="links" aria-label="Sections">
      <a class="more" href="/">Home</a>
      <a class="more" href="/research/">Research</a>
      <a class="more" href="/people/">People</a>
      <a class="more" href="/projects/">Projects</a>
      <a class="more" href="/publications/">Publications</a>
      <a class="more" href="/news/">News</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-3xl);
    display: grid;
    gap: var(--space-md);
  }

  .notfound h1 {
    font-size: var(--text-4xl);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-md);
  }
</style>
