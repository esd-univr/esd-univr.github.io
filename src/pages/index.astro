---
/**
 * Home page: identity + mission, research themes, featured work, selected
 * publications, people, recent news. Every section renders only when it has content.
 */
import NewsList from '../components/NewsList.astro';
import PeopleList from '../components/PeopleList.astro';
import ProjectList from '../components/ProjectList.astro';
import PublicationList from '../components/PublicationList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedPublications, getNews, getPeople, getProjects, getResearchAreas } from '../lib/content.ts';
import { currentMembers } from '../lib/people.ts';

const research = (await getResearchAreas()).filter((area) => area.data.status === 'active');
const projects = await getProjects();
const featuredProjects = projects.filter((p) => p.data.featured);
const highlightedProjects = (featuredProjects.length > 0 ? featuredProjects : projects.filter((p) => p.data.status === 'active')).slice(0, 4);
const people = await getPeople();
const members = currentMembers(people).slice(0, 8);
const publications = await getFeaturedPublications(5);
const news = (await getNews()).slice(0, 3);
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero container">
    <p class="eyebrow">{site.organisation.department} · {site.organisation.university}</p>
    <h1 class="hero__title">{site.name}</h1>
    <p class="hero__lede">{site.mission}</p>
    <nav class="hero__links" aria-label="Start here">
      <a class="more" href="/research/">Research</a>
      <a class="more" href="/publications/">Publications</a>
      <a class="more" href="/people/">People</a>
    </nav>
  </section>

  {research.length > 0 && (
    <section class="section container" aria-labelledby="home-research">
      <SectionHeading eyebrow="Research" title="Research themes" id="home-research" moreHref="/research/" moreLabel="All research" />
      <ol class="themes">
        {research.map((area, index) => (
          <li class="theme">
            <span class="theme__index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="theme__name"><a href={`/research/${area.id}/`}>{area.data.name}</a></h3>
              <p class="theme__summary">{area.data.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  {highlightedProjects.length > 0 && (
    <section class="section container" aria-labelledby="home-projects">
      <SectionHeading eyebrow="Projects" title="Featured and active work" id="home-projects" moreHref="/projects/" moreLabel="All projects" />
      <ProjectList projects={highlightedProjects} />
    </section>
  )}

  {publications.length > 0 && (
    <section class="section container" aria-labelledby="home-publications">
      <SectionHeading eyebrow="Publications" title="Selected publications" id="home-publications" moreHref="/publications/" moreLabel="All publications" />
      <PublicationList publications={publications} people={people} headingLevel={3} />
    </section>
  )}

  {members.length > 0 && (
    <section class="section container" aria-labelledby="home-people">
      <SectionHeading eyebrow="People" title="The group" id="home-people" moreHref="/people/" moreLabel="All people" />
      <PeopleList people={members} />
    </section>
  )}

  {news.length > 0 && (
    <section class="section container" aria-labelledby="home-news">
      <SectionHeading eyebrow="News" title="Recent news" id="home-news" moreHref="/news/" moreLabel="All news" />
      <NewsList items={news} />
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3xl) var(--space-2xl);
    display: grid;
    gap: var(--space-md);
  }

  .hero__title {
    font-size: var(--text-4xl);
    font-weight: 500;
    max-width: 18ch;
  }

  .hero__lede {
    font-size: var(--text-xl);
    line-height: 1.4;
    max-width: 34ch;
    color: var(--color-ink-2);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-sm);
  }

  .themes {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-xl);
  }

  .theme {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule-strong);
  }

  .theme__index {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  .theme__name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .theme__name a {
    text-decoration: none;
  }

  .theme__name a:hover {
    text-decoration: underline;
  }

  .theme__summary {
    color: var(--color-ink-2);
  }
</style>
