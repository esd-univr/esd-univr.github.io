---
/**
 * Home page: CISD identity, the three groups, selected projects, selected
 * publications, people and recent news. Every section renders only when it has content.
 */
import NewsList from '../components/NewsList.astro';
import OpportunityList from '../components/OpportunityList.astro';
import PeopleList from '../components/PeopleList.astro';
import ProjectList from '../components/ProjectList.astro';
import PublicationList from '../components/PublicationList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getFeaturedOpportunities,
  getFeaturedPublications,
  getGroups,
  getNews,
  getPeople,
  getProjects,
} from '../lib/content.ts';

const groups = await getGroups();
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const highlightedProjects = (featured.length > 0 ? featured : projects).slice(0, 4);
const people = await getPeople();
const publications = await getFeaturedPublications(5);
// Only explicitly featured open proposals, at most three — the section is omitted otherwise.
const opportunities = await getFeaturedOpportunities(3);
const news = (await getNews()).slice(0, 3);
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero container">
    <p class="eyebrow">{site.organisation.department} · {site.organisation.university}</p>
    <h1 class="hero__title">{site.name}</h1>
    <p class="hero__lede">{site.mission}</p>
    <nav class="hero__links" aria-label="Start here">
      <a class="more" href="/research/">Research</a>
      <a class="more" href="/publications/">Publications</a>
      <a class="more" href="/people/">People</a>
    </nav>
  </section>

  {groups.length > 0 && (
    <section class="section container" aria-labelledby="home-groups">
      <SectionHeading eyebrow="Groups" title={`The ${site.shortName} groups`} id="home-groups" moreHref="/research/" moreLabel="Research" />
      <ol class="groups">
        {groups.map((group) => (
          <li class="group">
            <p class="group__short">{group.data.shortName}</p>
            <div>
              <h3 class="group__name"><a href={`/research/#${group.id}`}>{group.data.name}</a></h3>
              <p class="group__summary">{group.data.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  {highlightedProjects.length > 0 && (
    <section class="section container" aria-labelledby="home-projects">
      <SectionHeading eyebrow="Projects" title="Selected projects" id="home-projects" moreHref="/projects/" moreLabel="All projects" />
      <ProjectList projects={highlightedProjects} />
    </section>
  )}

  {publications.length > 0 && (
    <section class="section container" aria-labelledby="home-publications">
      <SectionHeading eyebrow="Publications" title="Selected publications" id="home-publications" moreHref="/publications/" moreLabel="All publications" />
      <PublicationList publications={publications} people={people} headingLevel={3} />
    </section>
  )}

  {opportunities.length > 0 && (
    <section class="section container" aria-labelledby="home-opportunities">
      <SectionHeading
        eyebrow="For students"
        title="Student opportunities"
        id="home-opportunities"
        moreHref="/opportunities/"
        moreLabel="All opportunities"
      />
      <OpportunityList opportunities={opportunities} />
    </section>
  )}

  {people.length > 0 && (
    <section class="section container container--wide" aria-labelledby="home-people">
      <SectionHeading eyebrow="People" title="The groups' members" id="home-people" moreHref="/people/" moreLabel="All people" />
      <PeopleList people={people} />
    </section>
  )}

  {news.length > 0 && (
    <section class="section container" aria-labelledby="home-news">
      <SectionHeading eyebrow="News" title="Recent news" id="home-news" moreHref="/news/" moreLabel="All news" />
      <NewsList items={news} />
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3xl) var(--space-2xl);
    display: grid;
    gap: var(--space-md);
  }

  .hero__title {
    font-size: var(--text-4xl);
    font-weight: 500;
    max-width: 20ch;
  }

  .hero__lede {
    font-size: var(--text-xl);
    line-height: 1.4;
    max-width: 42ch;
    color: var(--color-ink-2);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-sm);
  }

  .groups {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-xl);
  }

  .group {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule-strong);
  }

  .group__short {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .group__name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .group__name a {
    text-decoration: none;
  }

  .group__name a:hover {
    text-decoration: underline;
  }

  .group__summary {
    color: var(--color-ink-2);
  }
</style>
