---
/**
 * Home page: the CISD identity, the three most recent news items, and the three groups.
 * Nothing else — Projects, People and Publications have their own pages, and as teasers
 * here they were three lists nobody reads.
 *
 * Bands alternate paper / paper-2 so the page reads as plates rather than one white sheet.
 */
import NewsList from '../components/NewsList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGroups, getNews } from '../lib/content.ts';

const groups = await getGroups();
const news = (await getNews()).slice(0, 3);
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero page-open container">
    <p class="eyebrow">{site.organisation.department} · {site.organisation.university}</p>
    <h1 class="hero__title">{site.name}</h1>
    <p class="hero__lede">{site.mission}</p>
    <nav class="hero__links" aria-label="Start here">
      <a class="more" href="/research/">Research</a>
      <a class="more" href="/publications/">Publications</a>
      <a class="more" href="/people/">People</a>
    </nav>
  </section>

  {/* News leads: it is the only part of the page that changes week to week. */}
  {news.length > 0 && (
    <div class="band band--sunken">
      <section class="section container" aria-labelledby="home-news">
        <SectionHeading eyebrow="News" title="Recent news" id="home-news" moreHref="/news/" moreLabel="All news" />
        <NewsList items={news} />
      </section>
    </div>
  )}

  {groups.length > 0 && (
    <div class="band">
      <section class="section container" aria-labelledby="home-groups">
        <SectionHeading eyebrow="Groups" title={`The ${site.shortName} groups`} id="home-groups" moreHref="/research/" moreLabel="Research" />
        <ol class="groups">
          {groups.map((group) => (
            <li class="group" data-group={group.id}>
              <p class="group__short">{group.data.shortName}</p>
              <div>
                <h3 class="group__name"><a href={`/research/#${group.id}`}>{group.data.name}</a></h3>
                <p class="group__summary">{group.data.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </div>
  )}
</BaseLayout>

<style>
  /* Padding comes from `.page-open` in base.css — the hero is this page's opening block. */
  .hero {
    display: grid;
    gap: var(--space-md) var(--space-2xl);
  }

  /* Size and measure come from `.page-open h1`; only the weight is the hero's own. */
  .hero__title {
    font-weight: 500;
  }

  .hero__lede {
    font-size: var(--text-xl);
    line-height: 1.4;
    max-width: 52ch;
    color: var(--color-ink-2);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-xs);
  }

  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: minmax(16rem, 0.9fr) minmax(26rem, 1.1fr);
      align-items: start;
    }

    .hero > .eyebrow {
      grid-column: 1 / -1;
    }

    .hero__title {
      grid-column: 1;
      grid-row: 2 / span 2;
    }

    .hero__lede {
      grid-column: 2;
      grid-row: 2;
    }

    .hero__links {
      grid-column: 2;
      grid-row: 3;
    }
  }

  .groups {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-xl);
  }

  /*
   * The margin column holds the group's short name. 5rem was enough at the old type
   * scale; at --text-sm plus 0.08em letter-spacing "IoT4Care" measures ~5.8rem and wrapped
   * onto two lines, so the column gets the room instead of the label getting smaller type.
   */
  .group {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    /* The 2px rule opening a group block is one of the places colour is allowed: it is
       identity, and the group's short name sits right beside it. */
    border-top: 2px solid var(--color-accent);
  }

  .group__short {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .group__name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .group__name a {
    text-decoration: none;
  }

  .group__name a:hover {
    text-decoration: underline;
  }

  .group__summary {
    color: var(--color-ink-2);
  }
</style>
