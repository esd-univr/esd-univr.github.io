---
/** Legacy /area/<id>/ → the group's section on /research/ (from `legacyAreaId`). */
import LegacyRedirect from '../../layouts/LegacyRedirect.astro';
import { getGroups } from '../../lib/content.ts';
import type { LegacyTarget } from '../../lib/legacy.ts';

export async function getStaticPaths() {
  const groups = await getGroups();
  return groups
    .filter((group) => group.data.legacyAreaId !== undefined)
    .map((group) => ({
      params: { legacyId: String(group.data.legacyAreaId) },
      props: { target: { legacyId: String(group.data.legacyAreaId), to: `/research/#${group.id}`, title: group.data.name } },
    }));
}

interface Props {
  target: LegacyTarget;
}

const { target } = Astro.props;
---

<LegacyRedirect target={target} legacyPath={`/area/${target.legacyId}/`} />
