---
/** Small definition-style list of labelled links (contacts, profiles, resources). */
interface Props {
  items: Array<{ label: string; href: string; text?: string }>;
}
const { items } = Astro.props;

/**
 * With no `text` the address is its own label, trimmed to what a reader can recognise:
 * no scheme, no query string, no fragment. Printed in full, a directory URL such as
 * `https://www.dimi.univr.it/?ent=persona&id=59&lang=en` broke mid-query-string across two
 * lines in the sidebar — a machine address masquerading as link text.
 */
const display = (item: Props['items'][number]): string =>
  item.text ?? item.href.replace(/^mailto:/, '').replace(/^https?:\/\//, '').replace(/[?#].*$/, '');
---

{items.length > 0 && (
  <ul class="link-list">
    {items.map((item) => (
      <li>
        <span class="eyebrow">{item.label}</span>
        <a href={item.href}>{display(item)}</a>
      </li>
    ))}
  </ul>
)}

<style>
  .link-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }

  .link-list li {
    display: grid;
    gap: var(--space-2xs);
  }

  .link-list a {
    overflow-wrap: anywhere;
  }
</style>
