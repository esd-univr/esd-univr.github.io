---
/** Site masthead and primary navigation. Works without JavaScript (plain links). */
import cisdLogoDark from '../content/assets/logo_cisd.dark_theme.png';
import cisdLogoLight from '../content/assets/logo_cisd.light_theme.png';
import { site } from '../data/site.ts';

const NAV = [
  { href: '/research/', label: 'Research' },
  { href: '/people/', label: 'People' },
  { href: '/projects/', label: 'Projects' },
  { href: '/assets/', label: 'Assets & Tools' },
  { href: '/opportunities/', label: 'Opportunities' },
  { href: '/publications/', label: 'Publications' },
  { href: '/news/', label: 'News' },
] as const;

const current = `/${Astro.url.pathname.split('/')[1] ?? ''}/`;
---

<header class="masthead">
  <div class="container masthead__inner">
    {/*
      The mark already reads "CISD", so the masthead does not set the acronym in type beside
      it — that was the same word twice. It sits *inside* the link rather than next to it for
      two reasons: a masthead mark is what people click to get home, and below 40rem the
      expanded name is hidden, which would otherwise leave the link with nothing in it.
    */}
    <a class="wordmark" href="/" aria-label={`${site.name} — home`}>
      <span class="masthead__brand-mark" aria-hidden="true">
        <img
          class="masthead__brand-logo masthead__brand-logo--light"
          src={cisdLogoLight.src}
          width={cisdLogoLight.width}
          height={cisdLogoLight.height}
          alt=""
        />
        <img
          class="masthead__brand-logo masthead__brand-logo--dark"
          src={cisdLogoDark.src}
          width={cisdLogoDark.width}
          height={cisdLogoDark.height}
          alt=""
        />
      </span>
      <span class="wordmark__long">{site.name}<span class="wordmark__affiliation"> · {site.organisation.university}</span></span>
    </a>
    <div class="masthead__end">
      <nav class="nav" aria-label="Main">
        <ul class="nav__list">
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      {/*
        Light/dark switch. Hidden until the inline script in BaseLayout.astro marks the
        document as scripted, because without JavaScript the theme follows the operating
        system and the button would do nothing. The half-filled disc reads as "change
        appearance" in either theme, so no icon swapping is needed; the script keeps the
        accessible name pointed at the action.
      */}
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M8 1.75a6.25 6.25 0 0 0 0 12.5Z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--color-rule-strong);
    padding-block: var(--space-sm) var(--space-xs);
  }

  /*
   * Two explicit rows, not one wrapping row: the mark and affiliation on top, navigation
   * and the theme toggle below. As a single flex row the navigation reflowed onto the
   * wordmark line whenever the available width changed by a few pixels — which happened
   * on every navigation to a page short enough to lose its scrollbar. The grid makes that
   * impossible, and `scrollbar-gutter: stable` in base.css removes the width change too.
   */
  .masthead__inner {
    display: grid;
    gap: var(--space-xs);
  }

  .masthead__brand-mark {
    display: inline-flex;
    align-items: center;
    flex: none;
  }

  .masthead__brand-logo {
    flex: none;
    width: auto;
    height: 2.4rem;
    object-fit: contain;
  }

  .masthead__brand-logo--dark {
    display: none;
  }

  :global(:root[data-theme='dark']) .masthead__brand-logo--light {
    display: none;
  }

  :global(:root[data-theme='dark']) .masthead__brand-logo--dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .masthead__brand-logo--light {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .masthead__brand-logo--dark {
      display: block;
    }
  }

  /* Centred, not baseline-aligned: the acronym that used to share a baseline with the
     affiliation line is gone, and what is left is a mark beside one line of text. */
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    min-width: 0;
    text-decoration: none;
  }

  .wordmark:hover {
    color: inherit;
  }

  .wordmark__long {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .wordmark__affiliation {
    color: var(--color-ink-3);
  }

  /* Row 2: navigation on the left, the theme toggle pushed to the right. */
  .masthead__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-lg);
  }

  /* Only offered when the theme script is running — see BaseLayout.astro. */
  .theme-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--color-ink-3);
    background: none;
    border: var(--rule);
    border-radius: var(--radius);
    cursor: pointer;
    transition: var(--transition-control);
  }

  :root[data-js] .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-paper-2);
  }

  .nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    list-style: none;
    padding: 0;
  }

  .nav__list a {
    display: inline-block;
    padding-block: var(--space-2xs);
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .nav__list a:hover {
    border-bottom-color: var(--color-accent);
  }

  .nav__list a[aria-current='page'] {
    border-bottom-color: var(--color-rule-strong);
    font-weight: 600;
  }

  @media (max-width: 40rem) {
    .wordmark__long {
      display: none;
    }
  }
</style>
