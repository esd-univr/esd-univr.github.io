---
/** Site masthead and primary navigation. Works without JavaScript (plain links). */
import { site } from '../data/site.ts';

const NAV = [
  { href: '/research/', label: 'Research' },
  { href: '/people/', label: 'People' },
  { href: '/projects/', label: 'Projects' },
  { href: '/opportunities/', label: 'Opportunities' },
  { href: '/publications/', label: 'Publications' },
  { href: '/news/', label: 'News' },
] as const;

const current = `/${Astro.url.pathname.split('/')[1] ?? ''}/`;
---

<header class="masthead">
  <div class="container masthead__inner">
    <a class="wordmark" href="/" aria-label={`${site.name} — home`}>
      {/*
        Only renders once `brand.logo` names a mark that survives 2.4rem — see site.ts.
        Add that file's intrinsic width and height here when it does, so the box is reserved
        before it loads. When a logo is present base.css drops the set-type "CISD" beside
        it, because the mark already reads it.
      */}
      {site.brand.logo ? <img class="wordmark__logo" src={site.brand.logo} alt="" /> : null}
      <span class="wordmark__short">{site.shortName}</span>
      <span class="wordmark__long">{site.name}<span class="wordmark__affiliation"> · {site.organisation.university}</span></span>
    </a>
    <div class="masthead__end">
      <nav class="nav" aria-label="Main">
        <ul class="nav__list">
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      {/*
        Light/dark switch. Hidden until the inline script in BaseLayout.astro marks the
        document as scripted, because without JavaScript the theme follows the operating
        system and the button would do nothing. The half-filled disc reads as "change
        appearance" in either theme, so no icon swapping is needed; the script keeps the
        accessible name pointed at the action.
      */}
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M8 1.75a6.25 6.25 0 0 0 0 12.5Z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--color-rule-strong);
    padding-block: var(--space-sm) var(--space-xs);
  }

  /*
   * Two explicit rows, not one wrapping row: the mark and affiliation on top, navigation
   * and the theme toggle below. As a single flex row the navigation reflowed onto the
   * wordmark line whenever the available width changed by a few pixels — which happened
   * on every navigation to a page short enough to lose its scrollbar. The grid makes that
   * impossible, and `scrollbar-gutter: stable` in base.css removes the width change too.
   */
  .masthead__inner {
    display: grid;
    gap: var(--space-xs);
  }

  /* Baseline, so the serif wordmark and the affiliation line sit on one line together;
     a mark, when there is one, centres itself against them instead. */
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-sm);
    text-decoration: none;
  }

  .wordmark:hover {
    color: inherit;
  }

  /* Fluid, tied to the type scale — never a fixed pixel height. */
  .wordmark__logo {
    align-self: center;
    height: 2.4rem;
    width: auto;
  }

  .wordmark__short {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .wordmark__long {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .wordmark__affiliation {
    color: var(--color-ink-3);
  }

  /* Row 2: navigation on the left, the theme toggle pushed to the right. */
  .masthead__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-lg);
  }

  /* Only offered when the theme script is running — see BaseLayout.astro. */
  .theme-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--color-ink-3);
    background: none;
    border: var(--rule);
    border-radius: var(--radius);
    cursor: pointer;
    transition: var(--transition-control);
  }

  :root[data-js] .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-paper-2);
  }

  .nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    list-style: none;
    padding: 0;
  }

  .nav__list a {
    display: inline-block;
    padding-block: var(--space-2xs);
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .nav__list a:hover {
    border-bottom-color: var(--color-accent);
  }

  .nav__list a[aria-current='page'] {
    border-bottom-color: var(--color-rule-strong);
    font-weight: 600;
  }

  @media (max-width: 40rem) {
    .wordmark__long {
      display: none;
    }
  }
</style>
