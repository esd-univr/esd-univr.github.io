---
/** Institutional footer: affiliation, address, useful links. */
import { site } from '../data/site.ts';

const year = new Date().getUTCFullYear();
const org = site.organisation;
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__name">{site.name} <span class="footer__short">({site.shortName})</span></p>
      <p><a href={org.departmentUrl}>{org.department}</a><br /><a href={org.universityUrl}>{org.university}</a></p>
    </div>
    <div>
      <h2 class="footer__heading">Address</h2>
      <address class="footer__address">
        {org.address.map((line) => <span>{line}</span>)}
        <a class="footer__map" href={org.mapUrl}>Map</a>
      </address>
    </div>
    <div>
      <h2 class="footer__heading">Links</h2>
      <ul class="footer__links">
        <li><a href="/contacts/">Contacts</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/publications/">Publications</a></li>
        <li><a href="/publications.bib">Bibliography (BibTeX)</a></li>
        <li><a href={site.links.github}>GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer__colophon">
    <p class="meta">© {year} {site.name}, {org.university}</p>
  </div>
</footer>

<style>
  /*
   * The footer is the last band: paper-2 closes the page, so the alternation reads all the
   * way down instead of the page fading out on the same white as its content. The
   * rule-strong edge still marks the boundary where a sunken section abuts it.
   */
  .footer {
    background: var(--color-paper-2);
    border-top: 1px solid var(--color-rule-strong);
    padding-block: var(--space-xl) var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-lg) var(--space-xl);
  }

  .footer__name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-ink);
    margin-bottom: var(--space-xs);
  }

  .footer__short {
    color: var(--color-ink-3);
  }

  .footer__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: var(--space-xs);
  }

  .footer__address {
    font-style: normal;
    display: grid;
  }

  .footer__map {
    margin-top: var(--space-xs);
    width: fit-content;
  }

  .footer__links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .footer__colophon {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: var(--rule);
  }
</style>
